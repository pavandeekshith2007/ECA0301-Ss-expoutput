// Question 18 Solution
clc; clear; close();
sigma = 5e-12;       // 5 ps pulse width
beta2 = -20e-24;     // Dispersion parameter
L = 50e3;            // Channel length 50 km
// Frequency grid
N = 2048;
f = linspace(-5e11, 5e11, N);
// Gaussian Input Spectrum X(f) = exp(-(pi*f*sigma)^2)
X_f = exp(-(%pi * f * sigma).^2);
// Channel Transfer Function H(f) = exp(-j * beta2 * (2*pi*f)^2 * L / 2)
H_f = exp(-%i * beta2 * (2 * %pi * f).^2 * (L / 2));
// Output Spectrum
Y_f = X_f .* H_f;
// Recover time-domain signals using inverse FFT shift and IFFT
x_t = abs(fftshift(ifft(X_f)));
y_t = abs(fftshift(ifft(Y_f)));
// Time vector
dt = 1 / (max(f) - min(f));
t_vec = (-N/2 : N/2 - 1) * dt * 1e12; // Time in picoseconds (ps)
// Plotting
scf(18);
plot(t_vec, x_t, 'b-', 'LineWidth', 2);
plot(t_vec, y_t, 'r-', 'LineWidth', 2);
xtitle('Pulse Broadening in Dispersion-Managed Channel', 'Time (ps)', 'Normalized Amplitude');
legend(['Input Pulse x(t)', 'Output Broadened Pulse y(t)']);
xgrid(1);
// Analytical Broadening Formula
// sigma_out = sigma * sqrt(1 + (beta2 * L / sigma^2)^2)
sigma_out_analytical = sigma * sqrt(1 + (beta2 * L / (sigma^2))^2);
mprintf("\n--- Question 18 Analysis Results ---\n");
mprintf("Initial Pulse Width: %.2e s (%.1f ps)\n", sigma, sigma * 1e12);
mprintf("Analytical Output Pulse Width: %.2e s (%.1f ps)\n", sigma_out_analytical, sigma_out_analytical * 1e12);
