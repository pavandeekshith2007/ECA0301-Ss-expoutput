clear;
clc;
clf;
x_n = [1, 2, 3]; // Signal x[n]
h_n = [1, -1]; // Signal h[n]
y_n = conv(x_n, h_n);
n_y = 0:(length(x_n) + length(h_n) - 2);
clf;
// Plot x[n]
subplot(3,1,1);
bar(0:length(x_n)-1, x_n, 'b');
xlabel('n');
ylabel('x[n]');
title('Signal x[n]');
// Plot h[n]
subplot(3,1,2);
bar(0:length(h_n)-1, h_n, 'r');
xlabel('n');
ylabel('h[n]');
title('Signal h[n]');
// Plot y[n] (convolution result)
subplot(3,1,3);
bar(n_y, y_n, 'g');
xlabel('n');
ylabel('y[n]');
title('Convolution of x[n] and h[n]');
