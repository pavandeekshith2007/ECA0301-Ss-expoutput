// Continuous time
t = -2:0.001:2;
u = (t >= 0);
r = t .* (t >= 0);
imp = (t == 0);
clf;
subplot(3,1,1);
plot(t, u);
xtitle("Unit Step (Continuous)");
subplot(3,1,2);
plot(t, r);
xtitle("Ramp (Continuous)");
subplot(3,1,3);
plot(t, imp);
xtitle("Impulse Approximation");
// Discrete time
n = -5:5;
ud = (n >= 0);
rd = n .* (n >= 0);
impd = (n == 0);
figure;
subplot(3,1,1);
plot2d3(n, ud);
xtitle("Unit Step (Discrete)");
subplot(3,1,2);
plot2d3(n, rd);
xtitle("Ramp (Discrete)");
subplot(3,1,3);
plot2d3(n, impd);
xtitle("Unit Impulse (Discrete)");
