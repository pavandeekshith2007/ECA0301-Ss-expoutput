clear;
clc;
t = 0:0.001:2;
T = 0.5;
sawtooth_wave = 2 * (t/T - floor(t/T + 0.5));
triangular_wave = 2 * abs(2 * (t/T - floor(t/T + 0.5))) - 1;
scf(0);
clf(0);
subplot(2,1,1);
plot(t, triangular_wave);
xtitle("Symmetric Triangular Waveform", "Time (s)", "Amplitude");
subplot(2,1,2);
plot(t, sawtooth_wave);
xtitle("Ramp-like Sawtooth Waveform", "Time (s)", "Amplitude");
