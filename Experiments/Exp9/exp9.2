clear;
clc;
clf();
x_n = [1, 2, 3, 4];
h_n = [2, 1];
N = length(x_n);
h_n_padded = [h_n, zeros(1, N - length(h_n))];
y_n = zeros(1, N);
for n = 0:N-1
    for k = 0:N-1
        idx = modulo(n - k, N);
        if idx < 0 then
            idx = idx + N;
        end
        y_n(n + 1) = y_n(n + 1) + x_n(k + 1) * h_n_padded(idx + 1);
    end
end
n_y = 0:N-1;
subplot(3, 1, 1);
bar(0:N-1, x_n, 0.5, 'blue');
xtitle('Signal x[n]', 'n', 'x[n]');
subplot(3, 1, 2);
bar(0:N-1, h_n_padded, 0.5, 'red');
xtitle('Signal h[n] (Padded)', 'n', 'h[n]');

subplot(3, 1, 3);
bar(n_y, y_n, 0.5, 'green');
xtitle('Circular Convolution of x[n] and h[n]', 'n', 'y[n]');
