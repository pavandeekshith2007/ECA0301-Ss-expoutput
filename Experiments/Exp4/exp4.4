clear;
clc;
clf;
t_min = -1;
t_max = 5;
dt = 0.01;
t = t_min:dt:t_max;
x_impulse = double(t == 0);
x_step = double(t >= 0);
a = 2;
b = 1;
y_impulse = zeros(1, length(t));
for i = 1:length(t)
    if t(i) >= 0 then
        y_impulse(i) = b * exp(-a * t(i));
    end
end
y_step = zeros(1, length(t));
for i = 1:length(t)
    if t(i) >= 0 then
        y_step(i) = (b / a) * (1 - exp(-a * t(i)));
    end
end
subplot(4,1,1);
plot(t, x_impulse, 'b');
xlabel('t (Time)');
ylabel('x(t)');
title('Input Signal x(t) - Impulse Function');
subplot(4,1,2);
plot(t, y_impulse, 'r');
xlabel('t (Time)');
ylabel('h(t)');
title('Output Signal y(t) - Impulse Response');
// Step Input
subplot(4,1,3);
plot(t, x_step, 'b');
xlabel('t (Time)');
ylabel('x(t)');
title('Input Signal x(t) - Step Function');
// Step Response Output
subplot(4,1,4);
plot(t, y_step, 'r');
xlabel('t (Time)');
ylabel('s(t)');
title('Output Signal y(t) - Step Response');
