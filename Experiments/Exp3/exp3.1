clear; clc;

// Define parameters
N = 30; // Time duration/samples
t = 0:0.01:N-1; // Continuous time vector (fine step size for smooth analog curves)

// Define Sequence 1: Sinusoidal signal
f1 = 0.05; // Frequency
A1 = 2;    // Amplitude
x1_t = A1 * sin(2 * %pi * f1 * t);

// Define Sequence 2: Exponentially decaying signal
a2 = 0.1; // Decay rate
A2 = 3;   // Amplitude
x2_t = A2 * exp(-a2 * t);

// Addition of the two signals
x_add = x1_t + x2_t;

// Multiplication of the two signals
x_mult = x1_t .* x2_t;

// Graphics setup
clf; // Clear current figure

// Plot Signal 1 (Sinusoidal)
subplot(4,1,1);
plot(t, x1_t, 'b', 'LineWidth', 1.5);
xlabel('t (Time)');
ylabel('Amplitude');
title('Sequence 1: Sinusoidal Sequence');

// Plot Signal 2 (Exponential Decay)
subplot(4,1,2);
plot(t, x2_t, 'b', 'LineWidth', 1.5);
xlabel('t (Time)');
ylabel('Amplitude');
title('Sequence 2: Exponentially Decaying Sequence');

// Plot Result of Addition
subplot(4,1,3);
plot(t, x_add, 'b', 'LineWidth', 1.5);
xlabel('t (Time)');
ylabel('Amplitude');
title('Addition of Sequence 1 and Sequence 2');

// Plot Result of Multiplication
subplot(4,1,4);
plot(t, x_mult, 'b', 'LineWidth', 1.5);
xlabel('t (Time)');
ylabel('Amplitude');
title('Multiplication of Sequence 1 and Sequence 2');
