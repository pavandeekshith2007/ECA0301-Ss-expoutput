// Experiment 3.4: Cross-Correlation of Two Sequences
clear;
clc;
clf;
N = 20;
pw = 5;
delay = 3;
x = [ones(1, pw), zeros(1, N - pw)];
y = [zeros(1, delay), ones(1, pw), zeros(1, N - pw - delay)];
n = 0:N-1;
r_xy = xcorr(x, y);
lags = 1:(2*N - 1);
subplot(3, 1, 1);
plot2d3(n, x, style=2);
plot(n, x, 'bo');
gca().data_bounds = [-1, -0.2; 20, 1.2];
xtitle("Sequence 1: Rectangular Pulse Sequence", "n (Discrete Time Index)", "Amplitude");
subplot(3, 1, 2);
plot2d3(n, y, style=3);
plot(n, y, 'go');
gca().data_bounds = [-1, -0.2; 20, 1.2];
xtitle("Sequence 2: Delayed Rectangular Pulse Sequence", "n (Discrete Time Index)", "Amplitude");
subplot(3, 1, 3);
plot2d3(lags, r_xy, style=5);
plot(lags, r_xy, 'ro');
gca().data_bounds = [0, -20; 40, 20];
xtitle("Cross-Correlation between Sequence 1 and Sequence 2", "Lag", "Cross-Correlation");
