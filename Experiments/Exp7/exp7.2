// Experiment 7.2: Fourier Series of Half-Wave Rectifier Output
clear;
clc;
clf;
f = 50;
T = 1/f;
t = 0:0.0001:3*T;
y_t = max(0, sin(2*%pi*f*t));
N_harmonics = 10;
a0 = 2 * sum(y_t) * (1/(2*T)) * 0.0001;
an = zeros(1, N_harmonics);
bn = zeros(1, N_harmonics);
for n = 1:N_harmonics
    an(n) = 2 * sum(y_t .* cos(2*%pi*n*f*t)) * (1/(2*T)) * 0.0001;
    bn(n) = 2 * sum(y_t .* sin(2*%pi*n*f*t)) * (1/(2*T)) * 0.0001;
end
y_reconstructed = a0/2 * ones(1, length(t));
for n = 1:N_harmonics
    y_reconstructed = y_reconstructed + an(n)*cos(2*%pi*n*f*t) + bn(n)*sin(2*%pi*n*f*t);
end
clf;
subplot(3,1,1);
plot(t, y_t, 'r');
xlabel('t (Time)');
ylabel('Amplitude');
title('Half-Wave Rectified Output Signal');
// Subplot 2: Reconstructed Signal
subplot(3,1,2);
plot(t, y_reconstructed, 'b');
xlabel('t (Time)');
ylabel('Amplitude');
title('Reconstructed Signal using Fourier Series with ' + string(N_harmonics) + ' Harmonics');
// Subplot 3: Comparison / Error
subplot(3,1,3);
plot(t, y_t, 'r');
plot(t, y_reconstructed, 'b--');
xlabel('t (Time)');
ylabel('Amplitude');
title('Overlay Comparison (Original vs Reconstructed)');
legend(["Original Signal", "Reconstructed Signal"]);
